# Database connection. Defaults to local SQLite for zero-setup demo runs.
# For docker-compose / production, use: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./ingestion.db

# Secrets referenced by sources/*.yaml via env_var. Only set what you actually use.
GITHUB_TOKEN=
NASA_API_KEY=DEMO_KEY

# Directory containing source config YAML files.
SOURCES_DIR=sources
